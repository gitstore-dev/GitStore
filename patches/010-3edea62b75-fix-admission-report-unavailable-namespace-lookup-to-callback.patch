+type namespaceResolutionFailOnceStore struct {
+	datastore.Datastore
+	repository bool
+	failure    error
+	pending    atomic.Bool
+}
+
+func (s *namespaceResolutionFailOnceStore) GetRepository(ctx context.Context, id string) (*datastore.Repository, error) {
+	if s.repository && s.pending.CompareAndSwap(true, false) {
+		return nil, s.failure
+	}
+	return s.Datastore.GetRepository(ctx, id)
+}
+
+func (s *namespaceResolutionFailOnceStore) GetNamespaceByName(ctx context.Context, name string) (*datastore.Namespace, error) {
+	if !s.repository && s.pending.CompareAndSwap(true, false) {
+		return nil, s.failure
+	}
+	return s.Datastore.GetNamespaceByName(ctx, name)
+}
+
+func TestAdmitResourcesNamespaceResolutionFailureCanReplay(t *testing.T) {
+	backendFailure := fmt.Errorf("private backend lookup detail")
+	for _, tc := range []struct {
+		name       string
+		repository bool
+		failure    error
+		revoke     bool
+	}{
+		{"repository unavailable", true, backendFailure, false},
+		{"namespace unavailable", false, backendFailure, false},
+		{"repository missing response", true, nil, false},
+		{"namespace missing response", false, nil, false},
+		{"policy revoked before replay", true, backendFailure, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			store := newTestDatastore(t)
+			failing := &namespaceResolutionFailOnceStore{Datastore: store, repository: tc.repository, failure: tc.failure}
+			failing.pending.Store(true)
+			var reads atomic.Int32
+			reader := &mockGitReader{
+				listFilesFunc: func(context.Context, string, string, string) ([]string, error) {
+					reads.Add(1)
+					return []string{"products/widget.md"}, nil
+				},
+				readFileFunc: func(context.Context, string, string, string) ([]byte, error) {
+					return makeProduct("widget"), nil
+				},
+			}
+			registry := auth.NewProviderRegistry(nil, testutil.NewAllowAllAuthZ(), nil)
+			var replicas []*catalogTestServer
+			for range 2 {
+				replicas = append(replicas, newCatalogServer(t, failing, reader, func(deps *cataloggrpc.ServerDeps) {
+					deps.Registry = registry
+				}))
+			}
+			req := &catalogv1.AdmitResourcesRequest{
+				RepositoryId: testRepoID,
+				NewCommitSha: strings.Repeat("a", 40),
+				RefName:      "refs/heads/main",
+				ChangedPaths: []string{"products/widget.md"},
+			}
+			response, err := replicas[0].AdmitResources(t.Context(), req)
+			require.Equal(t, codes.Unavailable, grpcstatus.Code(err))
+			require.Nil(t, response)
+			require.NotContains(t, err.Error(), backendFailure.Error())
+			require.NotContains(t, err.Error(), testRepoID)
+			require.Zero(t, reads.Load(), "unknown namespace must not start Git admission")
+			_, err = store.GetProductByName(t.Context(), "gitstore", "widget")
+			require.ErrorIs(t, err, datastore.ErrNotFound)
+
+			if tc.revoke {
+				registry.Swap(nil, testutil.NewDenyAllAuthZ(t), nil)
+			}
+			response, err = replicas[1].AdmitResources(t.Context(), req)
+			if tc.revoke {
+				require.Equal(t, codes.PermissionDenied, grpcstatus.Code(err))
+				require.Nil(t, response)
+				_, err = store.GetProductByName(t.Context(), "gitstore", "widget")
+				require.ErrorIs(t, err, datastore.ErrNotFound)
+				return
+			}
+			require.NoError(t, err)
+			require.NotNil(t, response)
+			product, err := store.GetProductByName(t.Context(), "gitstore", "widget")
+			require.NoError(t, err)
+			require.Equal(t, "gitstore", product.Namespace)
+			require.Equal(t, req.NewCommitSha, product.GitCommitSHA)
+		})
+	}
+}
