+    "${repo_root}/tests/capacity/preflight/api-readiness.sh" "${test_dir}/readiness-valid" >/dev/null 2>&1; then
+    echo "API readiness unexpectedly accepted an unapproved startup wrapper: ${mutation}" >&2
+    exit 1
+  fi
+done
