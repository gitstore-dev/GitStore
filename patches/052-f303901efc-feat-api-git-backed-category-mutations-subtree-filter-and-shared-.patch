+func categoryManifestTitled(name, title string) []byte {
+	return []byte("---\napiVersion: catalog.gitstore.dev/v1beta1\nkind: CategoryTaxonomy\nmetadata:\n  name: " + name +
+		"\n  namespace: gitstore\nspec:\n  title: " + title + "\n---\n")
+}
