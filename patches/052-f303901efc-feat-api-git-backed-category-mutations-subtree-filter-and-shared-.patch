+	aliceCategoryID := createdData.CreateCategory.Category.ID
+	require.NotEmpty(t, aliceCategoryID)
+
+	for _, tc := range []struct {
+		name string
+		resp func() gqlResponse
+	}{
+		{"create", func() gqlResponse {
