+func TestFileSnapshotsPreservePositionsAndIsolateCopies(t *testing.T) {
+	store, err := New()
+	require.NoError(t, err)
+	defer store.Close()
+	file := &datastore.File{
+		UID: "00000000-0000-0000-0000-000000000151", Namespace: "ns", Name: "hero",
