+	require.NoError(t, err)
+	deleted, started, err := e.service.deleteRepositoryWithOutcome(ctx, before.UID, "alice")
+	require.NoError(t, err)
+	require.True(t, started)
+	require.NotNil(t, deleted.DeletionTimestamp)
