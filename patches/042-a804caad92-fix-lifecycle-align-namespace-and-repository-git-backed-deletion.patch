+	now := time.Now().UTC().Truncate(time.Millisecond)
+	previous = ns.ResourceVersion
+	ns.DeletionTimestamp = &now
+	datastore.AdvanceNamespaceSystemVersion(ns)
+	require.NoError(t, storeA.MarkNamespaceDeletion(ctx, ns, previous))
