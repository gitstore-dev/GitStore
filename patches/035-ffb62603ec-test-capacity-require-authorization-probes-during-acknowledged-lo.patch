+		s.MinimumAcknowledgedAdvance = after - before
+	}
+	s.Cycles++
+	s.Allowed, s.Denied = [2]int64{s.Cycles, s.Cycles}, [2]int64{s.Cycles, s.Cycles}
+	s.LastCompletedMS, s.AcknowledgedAfter = last, after
+	s.UnavailableAttempts += unavailable
+	return nil
