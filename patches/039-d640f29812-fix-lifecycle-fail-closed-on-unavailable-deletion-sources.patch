+					r := &datastore.File{UID: uid, Namespace: ns.Name, Name: "child", ResourceVersion: "1", CreationTimestamp: now}
+					repositoryID = &r.RepositoryID
+					create = func() error { return ds.CreateFile(ctx, r) }
