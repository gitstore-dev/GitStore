# gitstore-api example config
# Copy to /etc/gitstore/gitstore-api.toml and adjust for your deployment.

[api]
port = 4000
git_port = 9000
grpc_port = 6000

[api.rate_limit]
per_second = 50
burst = 100

[api.git_service]
uri = "dns:///localhost:50051"

[api.auth.static_users]
users_file = "/etc/gitstore/users.yaml"

[api.auth.jwt]
secret = "replace-with-strong-random-secret-at-least-32-chars"
ttl = "24h"
issuer = "gitstore"
refresh_grace = "60s"

[api.auth.authn]
chain = ["static-users", "anonymous"]

[api.auth.authz]
provider = "allow-all"

[api.auth.userdir]
provider = "static-users"

[api.auth.rbac_local]
policy_file = "/etc/gitstore/policy.yaml"

[api.datastore]
backend = "memdb"

[grpc_auth]
hmac_secret = "replace-with-shared-hmac-secret"

[push_limits]
max_pack_size = "512MiB"
max_file_size = "100MiB"

[log]
level = "info"
format = "json"

# Optional Scylla configuration when api.datastore.backend = "scylla"
# [api.datastore.scylla]
# hosts = ["localhost:9042"]
# keyspace = "gitstore"
# username = ""
# password = ""
# tls = false
