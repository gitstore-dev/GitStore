# DEVELOPMENT / EVALUATION ONLY. Production requires a reviewed policy.
# Breaking v1beta1 baseline: legacy action lists, deny rules and namespaced
# ServiceAccount subjects are rejected, never translated.
# Operator guide: ../docs/authorization.md
apiVersion: rbac.authorization.gitstore.dev/v1beta1
kind: RbacLocalConfiguration
defaultDeny: true
clusterRoles:
  cluster-admin:
    rules:
      - resources: ["*"]
        verbs: ["*"]
  admin:
    rules:
      - resources: [repository, categoryTaxonomy, product, productVariant, collection, file]
        verbs: [create, read, list, watch, update, delete, transfer]
      - resources: [repository, categoryTaxonomy, product]
        verbs: [purge]
      - resources: [product/management, productVariant/management]
        verbs: [read, list]
  edit:
    rules:
      - resources: [repository, categoryTaxonomy, product, productVariant, collection, file]
        verbs: [create, read, list, watch, update, delete]
      - resources: [product/management, productVariant/management]
        verbs: [read, list]
  view:
    rules:
      - resources: [repository, categoryTaxonomy, product, productVariant, collection, file]
        verbs: [read, list, watch]
      - resources: [product/management, productVariant/management]
        verbs: [read, list]
  # Bind this ClusterRole with a RoleBinding for each user's namespace.
  # The binding confines wildcard grants to namespaced actions in that namespace.
  # Do not use a ClusterRoleBinding for this role: that grants cluster-wide access.
  namespace-full-control:
    rules:
      - resources: ["*"]
        verbs: ["*"]
  # This grants access to the namespace object itself, not its child resources.
  # USER namespace ownership is immutable: admission rejects owner changes even
  # when a rule grants transfer. ORGANIZATION namespaces may be transferred.
  namespace-owner:
    rules:
      - resources: [namespace]
        verbs: [read, update, delete, transfer]
        when: [owner]
  # Admission requires USER metadata.name == authenticated username == owner.
  # Name uniqueness permits at most one USER namespace per user at a time.
  # Creation alone does not grant access to resources inside that namespace.
  namespace-creator:
    rules:
      - resources: [namespace]
        verbs: [create]
        when: [{attr: tier, op: eq, value: USER}]
  controller:
    rules:
      - resources: [namespace, repository, categoryTaxonomy, product, file]
        verbs: [read, list, watch]
      - resources: [namespace/status, repository/status, categoryTaxonomy/status, product/status, file/status]
        verbs: [write]
      - resources: [namespace, repository, categoryTaxonomy, product]
        verbs: [purge]
      - resources: [namespace/system-repository]
        verbs: [provision]
      - resources: [repository]
        verbs: [create]
      - resources: [product/management]
        verbs: [read, list]
  controller-token:
    rules:
      - resources: [serviceAccount/token]
        verbs: [issue]
        resourceNames: [gitstore-controller-manager]
  system:api-internal:
    rules:
      - resources: [repository]
        verbs: [create, delete]
      - resources: [repository/contents]
        verbs: [read, write]
  public-reader:
    rules:
      - resources: [repository/contents]
        verbs: [read]
        when: [{attr: visibility, op: eq, value: public}]
roles: {}
# Optional Role: replace `roles: {}` above with this mapping, then adapt names.
# Role definitions have no namespace; the RoleBinding supplies the scope.
# roles:
#   catalog-maintainer:
#     rules:
#       - resources: [repository]
#         verbs: [read, update]
#         resourceNames: [catalog, seasonal-catalog]
#       - resources: [product]
#         verbs: [read, update]
#         resourceNames: [coffee, tea]
#       - resources: [repository/contents]
#         verbs: [read]
#         resourceNames: [catalog]
# resourceNames matches exact resource names, not IDs, namespace/name paths or
# patterns. Omitted or [] means all names within the binding's scope. A named
# grant cannot authorize list/watch requests, which have no resource name.
# Keep create grants in separate rules without resourceNames. The current
# provider accepts named create rules and checks the proposed name when supplied.
# Rules and bindings add grants: another broad grant can allow other names.
# Optional when examples: add rules like these to the Role above as needed.
# Each condition in a rule must match; attributes must be supplied by the action.
#       - resources: [repository]
#         verbs: [update]
#         when: [owner]
#       - resources: [repository]
#         verbs: [transfer]
#         when: [owner, targetOwnerMember]
#       - resources: [repository/contents]
#         verbs: [read]
#         when:
#           - {attr: namespace, op: in, values: [acme, storefront]}
#           - {attr: visibility, op: eq, value: public}
# Alternative comparisons (use instead of the allow-lists above as appropriate):
#           - {attr: namespace, op: notIn, values: [restricted, internal]}
#           - {attr: visibility, op: neq, value: private}
# eq/neq require a string value; in/notIn require a nonempty string values list.
# Missing/wrong-type attributes fail even neq/notIn. Tier comparisons belong on
# actions supplying tier, e.g. namespace-creator above (USER or ORGANIZATION).
clusterRoleBindings:
  - roleRef: {kind: ClusterRole, name: cluster-admin}
    subjects: [{kind: User, name: admin}]
  - roleRef: {kind: ClusterRole, name: namespace-owner}
    subjects: [{kind: Group, name: 'system:authenticated'}]
  - roleRef: {kind: ClusterRole, name: namespace-creator}
    subjects: [{kind: Group, name: 'system:authenticated'}]
  - roleRef: {kind: ClusterRole, name: controller}
    subjects: [{kind: ServiceAccount, name: gitstore-controller-manager}]
  - roleRef: {kind: ClusterRole, name: controller-token}
    subjects: [{kind: ServiceAccount, name: gitstore-controller-manager}]
  - roleRef: {kind: ClusterRole, name: 'system:api-internal'}
    subjects: [{kind: User, name: 'system:api'}]
  - roleRef: {kind: ClusterRole, name: public-reader}
    subjects: [{kind: Group, name: 'system:unauthenticated'}]
roleBindings: []
# Optional RoleBindings: replace `roleBindings: []` above with this list.
# roleBindings:
#   # USER namespace: alice controls all namespaced resources in namespace alice.
#   # Adapt both names to the authenticated username; repeat for each user.
#   - namespace: alice
#     roleRef: {kind: ClusterRole, name: namespace-full-control}
#     subjects: [{kind: User, name: alice}]
#   # Grant the custom Role above to a user, only in gitstore-system namespace.
#   - namespace: gitstore-system
#     roleRef: {kind: Role, name: catalog-maintainer}
#     subjects: [{kind: User, name: alice}]
#   # Reuse a ClusterRole, confined to gitstore-system rather than all namespaces.
#   - namespace: gitstore-system
#     roleRef: {kind: ClusterRole, name: view}
#     subjects: [{kind: Group, name: catalog-readers}]
# A RoleBinding cannot grant cluster-scoped namespace or serviceAccount actions.
# For those, use a ClusterRoleBinding referencing a ClusterRole, as above.
# rbac-local reads static bindings: it does not substitute the current username
# or provision a binding when a USER namespace is created. Operators must add
# each binding explicitly. Dynamic RBAC providers can use the same role/binding
# model; automatic binding provisioning requires namespace lifecycle integration.
# Wildcard grants still respect admission invariants and transfer constraints.
