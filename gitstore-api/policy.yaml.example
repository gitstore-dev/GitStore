# policy.yaml.example — rbac-local policy file
#
# Copy this file to `policy.yaml` (or any path referenced by
# GITSTORE_API__AUTH__RBAC_LOCAL__POLICY_FILE) when GITSTORE_API__AUTH__AUTHZ__PROVIDER=rbac-local.
#
# `version` must be "v1".
version: v1

# roles maps role name -> permissions.
roles:
  admin:
    allow:
      - "*"                  # wildcard: all actions
    deny: []

  controller:
    allow:
      - "*.status.write"
      - "category.status.write"
      - "categoryTaxonomy.list"
      - "categoryTaxonomy.purge"
      - "namespace.purge"
      - "namespace.status.write"
      - "namespace.watch"
      - "repository.create.any"
      - "repository.purge"
      - "product.purge"
      - "serviceaccount.token.issue"
    deny: []

  namespace-owner:
    allow:
      - namespace.read
      - namespace.update
      - namespace.delete.own     # only own namespaces
      - namespace.transfer       # API also requires caller owns the namespace and is a member of the target owner
      - repository.read
      - repository.write
      - repository.create.own
      - repository.rename.own
      - repository.transfer.own
      - repository.delete.own
      - repository.read.own
      - categoryTaxonomy.list
      - categoryTaxonomy.read
    deny:
      - namespace.delete.any     # cannot delete other owners' namespaces

  # Category mutations (categoryTaxonomy.create|update|delete) are not granted
  # to these shared roles: rbac-local grants are global, not namespace-scoped.
  # Grant them to a per-tenant role, or use a provider that scopes decisions by
  # the request's namespace attribute.
  developer:
    allow:
      - namespace.read
      - repository.read
      - repository.write
      - repository.read.any
      - categoryTaxonomy.list
      - categoryTaxonomy.read
    deny: []

  anonymous:
    allow:
      - categoryTaxonomy.list
      - categoryTaxonomy.read
      - namespace.read
      - repository.read
      - repository.read.any
    deny:
      - repository.write
      - namespace.create
      - namespace.delete.any

# default_deny applies when no role rule matches. Defaults to true if omitted.
default_deny: true

# role_bindings maps subject (username from your AuthN provider, e.g. a
# static-users entry, or service account subject) -> list of roles. Every
# configured static-users identity and service account that should be able
# to access the API MUST have an entry here, or every request from that
# identity will be denied by default_deny.
#
# Service account subjects use the format: serviceaccount:<namespace>:<name>
role_bindings:
  "alice":
    - admin
  "bob":
    - developer
  "serviceaccount:controllers:gitstore-controller-manager":
    - controller
