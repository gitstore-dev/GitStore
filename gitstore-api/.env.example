# gitstore-api configuration
# Copy this file to .env and fill in the required values.
# Shell environment variables always override values in this file.

# ── Required ──────────────────────────────────────────────────────────────────

# Static users credentials (required when static-users is in the AuthN chain)
GITSTORE_API__AUTH__STATIC_USERS__USERS_FILE=../config/users.yaml  # tracked development-only fixture
GITSTORE_API__AUTH__JWT__SECRET=            # min 32 chars random string — generate with: make secret TARGET=jwt
GITSTORE_GRPC_AUTH__HMAC_SECRET=            # shared HMAC secret for gRPC inter-service auth — generate with: make secret TARGET=grpc-hmac

# ── Required with defaults ────────────────────────────────────────────────────

# Git service connection (default: localhost ports of gitstore-git-service)
GITSTORE_API__GIT_SERVICE__URI=dns:///localhost:50051  # string  — git service gRPC address
GITSTORE_API__GIT_PORT=9000                     # int     — git smart HTTP listen port
GITSTORE_API__GRPC_PORT=6000

# ── Optional ──────────────────────────────────────────────────────────────────

GITSTORE_API__PORT=4000                   # int      — HTTP API listen port
GITSTORE_LOG__LEVEL=info                  # string   — debug | info | warn | error
GITSTORE_LOG__FORMAT=text                 # string   — log format (json or text)

# JWT settings
GITSTORE_API__AUTH__JWT__TTL=24h               # duration — JWT token lifetime
GITSTORE_API__AUTH__JWT__ISSUER=gitstore       # string   — JWT issuer claim
GITSTORE_API__AUTH__JWT__REFRESH_GRACE=60s     # duration — window after expiry during which refresh is allowed

# Auth provider chain
# Comma-separated list of AuthN providers tried in order; first Allow wins.
# Available today: static-users, serviceaccount-assertion, serviceaccount-jwt, anonymous
# serviceaccount-assertion/serviceaccount-jwt are required for
# gitstore-controller-manager (and any other enrolled ServiceAccount) to
# authenticate against this API — omitting them makes every controller watch
# request fail with "invalid or expired credentials" even after a successful
# `make enroll-controller-serviceaccount`/`gitctl enroll-serviceaccount`.
# The anonymous provider must always be last.
GITSTORE_API__AUTH__AUTHN__CHAIN=static-users,serviceaccount-assertion,serviceaccount-jwt,anonymous  # default

# AuthZ provider — controls access-control decisions.
# Available: allow-all (dev), rbac-local (file-based RBAC)
GITSTORE_API__AUTH__AUTHZ__PROVIDER=allow-all  # default; use rbac-local in production

# User-directory provider (optional).
# Available: none, static-users
GITSTORE_API__AUTH__USERDIR__PROVIDER=static-users

# ── RBAC local provider (required when rbac-local is the AuthZ provider) ──────

# GITSTORE_API__AUTH__RBAC_LOCAL__POLICY_FILE=../config/policy.yaml  # tracked development-only fixture

# ── Datastore ─────────────────────────────────────────────────────────────────

GITSTORE_API__DATASTORE__BACKEND=memdb    # string  — memdb (default) | scylla

# ScyllaDB configuration (only used when GITSTORE_API__DATASTORE__BACKEND=scylla)
GITSTORE_API__DATASTORE__SCYLLA__HOSTS=localhost:9042  # string  — comma-separated host:port list
GITSTORE_API__DATASTORE__SCYLLA__KEYSPACE=gitstore     # string  — keyspace name
GITSTORE_API__DATASTORE__SCYLLA__USERNAME=             # string  — authentication username
GITSTORE_API__DATASTORE__SCYLLA__PASSWORD=             # string  — authentication password
GITSTORE_API__DATASTORE__SCYLLA__TLS=false             # bool    — enable TLS

# Rate limiting configuration (optional)
# GITSTORE_API__RATE_LIMIT__PER_SECOND=50
# GITSTORE_API__RATE_LIMIT__BURST=100

# Platform push ceiling, shared with gitstore-git-service (optional; IEC sizes).
# Namespace push-policy defaults may lower these limits but never exceed them.
# GITSTORE_PUSH_LIMITS__MAX_PACK_SIZE=512MiB
# GITSTORE_PUSH_LIMITS__MAX_FILE_SIZE=100MiB
