{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gitstore.dev/rbac.authorization.gitstore.dev/v1beta1/rolebinding.schema.json",
  "title": "GitStore RoleBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "rbac.authorization.gitstore.dev/v1beta1"},
    "kind": {"const": "RoleBinding"},
    "metadata": {"allOf": [{"$ref": "role.schema.json#/$defs/ObjectMeta"}, {"required": ["namespace"]}]},
    "spec": {"$ref": "role.schema.json#/$defs/BindingSpec"}
  }
}
