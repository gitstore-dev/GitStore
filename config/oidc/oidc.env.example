# Environment for the optional reference OIDC provider stack (spec 059).
# Copy to the repository-root `.env` (compose's default env file) and replace
# every value with a locally generated secret — e.g. `openssl rand -hex 32`.
# Nothing secret-bearing is ever committed (same convention as compose.scylla.yml
# / compose.admin.yml).

# Postgres credentials (each Ory service owns its own database)
HYDRA_DB_PASSWORD=change-me-hydra-db
KRATOS_DB_PASSWORD=change-me-kratos-db

# Hydra secrets (32+ characters each)
HYDRA_SECRETS_SYSTEM=change-me-hydra-system-secret-32-chars-min
HYDRA_SECRETS_COOKIE=change-me-hydra-cookie-secret-32-chars-min

# Kratos secrets (32+ characters each)
KRATOS_SECRETS_COOKIE=change-me-kratos-cookie-secret-32-chars-min
KRATOS_SECRETS_DEFAULT=change-me-kratos-default-secret-32-chars-min

# Ory reference self-service UI cookie secrets (32+ characters each)
KRATOS_UI_COOKIE_SECRET=change-me-ui-cookie-secret-32-chars-min
KRATOS_UI_CSRF_SECRET=change-me-ui-csrf-secret-32-chars-min

# Registered first-party OAuth2 client (created idempotently by hydra-client-setup)
GITSTORE_OIDC_CLIENT_ID=gitstore
GITSTORE_OIDC_CLIENT_SECRET=change-me-oidc-client-secret-32-chars-min
# Audience the client may request; also what the api overlay verifies and the
# bridge grants by default (defaults to the client_id)
GITSTORE_OIDC_CLIENT_AUDIENCE=gitstore
# Comma-separated callback URLs of whichever client application drives the flow
GITSTORE_OIDC_REDIRECT_URIS=http://localhost:3000/callback

# Optional host-port overrides (defaults shown)
# GITSTORE_HOST_OIDC_ISSUER_PORT=4444
# GITSTORE_HOST_KRATOS_PUBLIC_PORT=4433
# GITSTORE_HOST_KRATOS_UI_PORT=4455
# GITSTORE_HOST_MAILSLURPER_PORT=4436
# GITSTORE_HOST_OIDC_BRIDGE_PORT=4445
