{
  "$id": "https://gitstore.dev/schemas/identity/serviceaccount/v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitStore ServiceAccount",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "source_uid": { "type": "string", "format": "uuid", "maxLength": 36 },
        "source_name": { "type": "string", "minLength": 1, "maxLength": 253 }
      },
      "required": ["source_uid", "source_name"],
      "additionalProperties": false
    }
  }
}
