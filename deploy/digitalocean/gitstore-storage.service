[Unit]
Description=Verify and mount GitStore persistent storage
After=local-fs.target
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gitstore-storage
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
