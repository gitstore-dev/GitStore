# gitstore-git-service configuration
# Copy this file to .env and fill in values as needed.
# Shell environment variables always override values in this file.
# All keys are optional — the service starts without any configuration.

# ── Core ──────────────────────────────────────────────────────────────────────

GITSTORE_GIT_SERVICE__GRPC_PORT=50051                # u16    — gRPC service port
GITSTORE_GIT_SERVICE__DATA_DIR=.gitstore/repos       # string — path to bare repository storage under the repo-root .gitstore dir
GITSTORE_LOG__LEVEL=info                             # string — trace | debug | info | warn | error
GITSTORE_LOG__FORMAT=text                            # string — log format (json or text)

# ── Push limits ───────────────────────────────────────────────────────────────
# Platform ceiling shared with gitstore-api (IEC sizes). Repository push policies
# may lower these limits but never exceed them.
GITSTORE_PUSH_LIMITS__MAX_PACK_SIZE=512MiB
GITSTORE_PUSH_LIMITS__MAX_FILE_SIZE=100MiB

# ── Admission ─────────────────────────────────────────────────────────────────
# Pre-receive validation and post-receive admission always run.
GITSTORE_GIT_SERVICE__ADMISSION__BRANCH_PATTERN='^refs/heads/main$' # regex of refs admitted into the catalogue, e.g. ^refs/heads/(main|release/.+)$

# ── Validation ────────────────────────────────────────────────────────────────
GITSTORE_GIT_SERVICE__VALIDATION__TIMEOUT=10s        # duration — catalogue validation timeout (ms|s|m|h)

GITSTORE_GIT_SERVICE__CATALOG__URI=dns:///localhost:6000  # string — catalogue gRPC address (dns:///host:port)

# ── Authentication ────────────────────────────────────────────────────────────
# Shared HMAC secret validated by the gRPC inter-service interceptor.
# Must match GITSTORE_GRPC_AUTH__HMAC_SECRET in gitstore-api.
# Generate with: make secret TARGET=grpc-hmac (run in repo root, writes to gitstore-api/.env)
GITSTORE_GRPC_AUTH__HMAC_SECRET=           # required; service rejects all API calls without this
